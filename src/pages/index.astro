---
import Layout from '../layouts/Layout.astro';
import { colorionHref } from '../data/colorion';
import ButtonCard from '../components/ButtonCard.astro';
import GalleryModal from '../components/GalleryModal.astro';
import CollectionLinks from '../components/CollectionLinks.astro';
import { effects, liveCss } from '../data/buttons';
import { guides } from '../data/guides';
---
<Layout>
  <main id="main" tabindex="-1" data-page-type="gallery">
    <section class="hero home-hero">
      <div>
        <span class="hero-tag mono">Pure CSS · Copy &amp; paste</span>
        <h1>{effects.length} <em>CSS animated buttons</em>, free to copy.</h1>
        <p>Try a hover effect, copy the HTML and CSS, and make it yours. Explore fills, glows, borders, and shadows. Every export includes keyboard focus and reduced-motion styles.</p>
        <div class="inline-actions"><a class="action-button" href="#all-buttons">Browse all buttons</a><a href="/tools/button-generator/">Customize a button ↗</a></div>
      </div>
      <div class="hero-sample"><button class="btn fx-14" type="button"><span class="btn-label">Try the glow</span></button><p>Hover or use your keyboard to try it.</p><a href="/effects/glow/">See how this button works ↗</a></div>
    </section>
    <div class="page-width">
      <section class="section" aria-labelledby="collections-heading">
        <div class="section-heading"><h2 id="collections-heading">Find your kind of button.</h2><a href="/collections/">All collections ↗</a></div>
        <CollectionLinks />
      </section>
      <section class="section" id="all-buttons" aria-labelledby="gallery-heading">
        <div class="section-heading"><h2 id="gallery-heading">The complete library.</h2><span class="gallery-count">{effects.length} CSS effects</span></div>
        <div class="gallery-toolbar" id="gallery-tools" hidden>
          <div class="gallery-search"><label for="button-search">Find a button by name</label><input id="button-search" type="search" placeholder="Try glow, fill, arrow…" autocomplete="off" /></div>
          <p class="gallery-count" id="search-count" role="status" aria-live="polite">{effects.length} buttons</p>
        </div>
        <div class="panel"><div class="library-head"><span class="mono">Hover to preview. Open Code to copy.</span></div><div class="grid" id="button-grid">{effects.map((effect) => <ButtonCard effect={effect} />)}</div></div>
        <p class="empty-state" id="search-empty" hidden>No buttons match that name. Try another word or clear the search.</p>
      </section>
      <section class="section" aria-labelledby="guides-heading">
        <div class="section-heading"><h2 id="guides-heading">Make the code your own.</h2><a href="/guides/">All guides ↗</a></div>
        <div class="resource-list">{guides.map((guide) => <a href={`/guides/${guide.slug}/`}><strong>{guide.name}</strong><p>{guide.summary}</p><span aria-hidden="true">↗</span></a>)}</div>
      </section>
      <aside class="reading-note" aria-label="Related Colorion tools"><p>Need a gradient surface? Explore <a href={colorionHref('https://gradientbuttons.colorion.co/')}>Gradient Buttons</a>. For pointer-tracking motion, see the <a href={colorionHref('https://kinetics.colorion.co/effects/magnetic-button/')}>Kinetics magnetic button</a> or <a href={colorionHref('https://kinetics.colorion.co/tools/spring-animation-generator/')}>spring animation generator</a>.</p></aside>
    </div>
    <GalleryModal />
    <style is:global set:html={liveCss}></style>
  </main>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#button-search')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#button-grid > [data-effect-name]')];
  const count = document.querySelector('#search-count')!;
  const empty = document.querySelector<HTMLElement>('#search-empty')!;
  document.querySelector('#gallery-tools')!.removeAttribute('hidden');
  input.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let found = 0;
    for (const card of cards) { card.hidden = !card.dataset.effectName!.toLowerCase().includes(query); if (!card.hidden) found++; }
    count.textContent = `${found} ${found === 1 ? 'button' : 'buttons'}`;
    empty.hidden = found > 0;
  });
</script>
